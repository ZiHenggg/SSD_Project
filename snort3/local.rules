# Local Snort3 Rules
# Custom rules for your environment

# === ICMP Rules ===
# Detect ICMP ping sweeps
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Sweep"; itype:8; threshold:type threshold, track by_src, count 10, seconds 60; sid:1000001; rev:1;)

# Detect large ICMP packets (potential covert channel)
alert icmp any any -> any any (msg:"Large ICMP Packet"; dsize:>1000; sid:1000002; rev:1;)

# === TCP Rules ===
# Detect TCP port scanning
alert tcp any any -> $HOME_NET any (msg:"TCP Port Scan"; flags:S; threshold:type threshold, track by_src, count 20, seconds 60; sid:1000003; rev:1;)

# Detect SYN flood attempts
alert tcp any any -> $HOME_NET any (msg:"Possible SYN Flood"; flags:S; threshold:type threshold, track by_dst, count 100, seconds 10; sid:1000004; rev:1;)

# Detect Telnet connections (insecure)
alert tcp any any -> $HOME_NET 23 (msg:"Telnet Connection Attempt"; flow:to_server,established; sid:1000005; rev:1;)

# === HTTP Rules ===
# Detect HTTP directory traversal attempts
alert tcp any any -> $HOME_NET 80 (msg:"HTTP Directory Traversal"; flow:to_server,established; content:"../"; http_uri; sid:1000006; rev:1;)

# Detect SQL injection attempts in HTTP
alert tcp any any -> $HOME_NET 80 (msg:"HTTP SQL Injection Attempt"; flow:to_server,established; content:"union"; http_uri; nocase; sid:1000007; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"HTTP SQL Injection SELECT"; flow:to_server,established; content:"select"; http_uri; nocase; sid:1000008; rev:1;)

# Detect XSS attempts
# alert tcp any any -> $HOME_NET 80 (msg:"HTTP XSS Attempt"; flow:to_server,established; content:"<script"; http_uri; nocase;sid:1000009; rev:1;)

# === DNS Rules ===
# Detect DNS tunneling (large TXT records)
alert udp any any -> any 53 (msg:"DNS Possible Tunneling - Large TXT Query"; content:"|00 10|"; offset:12; depth:2; content:"|00|"; distance:0; within:1; byte_test:1,>,50,2,relative; sid:1000010; rev:1;)

# Detect suspicious DNS queries
alert udp any any -> any 53 (msg:"DNS Suspicious Long Domain"; content:"|01 00|"; offset:2; depth:2; content:"|00 01 00 01|"; distance:8; within:4; byte_test:1,>,50,12; sid:1000011; rev:1;)

# === SSH Rules ===
# Detect SSH brute force attempts
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flow:to_server,established; content:"SSH-"; depth:4; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000012; rev:1;)

# === FTP Rules ===
# Detect FTP brute force
alert tcp any any -> $HOME_NET 21 (msg:"FTP Brute Force"; flow:to_server,established; content:"USER"; depth:4; threshold:type threshold, track by_src, count 10, seconds 300; sid:1000013; rev:1;)

# === Malware Detection ===
# Detect known malware user agents
alert tcp any any -> any 80 (msg:"Malware User Agent - Possible Bot"; flow:to_server,established; content:"User-Agent|3A| "; http_header; content:"bot"; http_header; nocase; sid:1000014; rev:1;)

# Detect cryptocurrency mining traffic
alert tcp any any -> any any (msg:"Cryptocurrency Mining Pool Connection"; flow:to_server,established; content:"stratum+tcp"; sid:1000015; rev:1;)

# === P2P and File Sharing ===
# Detect BitTorrent traffic
alert tcp any any -> any any (msg:"BitTorrent Traffic"; content:"|13|BitTorrent protocol"; depth:20; sid:1000016; rev:1;)

# === Reconnaissance ===
# Detect Nmap OS fingerprinting
alert tcp any any -> $HOME_NET any (msg:"Nmap OS Fingerprint Attempt"; flags:FPU; sid:1000017; rev:1;)

# Detect NULL scan
alert tcp any any -> $HOME_NET any (msg:"NULL Scan"; flags:0; sid:1000018; rev:1;)

# Detect XMAS scan  
alert tcp any any -> $HOME_NET any (msg:"XMAS Scan"; flags:FPU; sid:1000019; rev:1;)

# === Network Anomalies ===
# Detect packets with reserved IP addresses
alert ip 224.0.0.0/4 any -> any any (msg:"Multicast Source Address"; sid:1000020; rev:1;)
alert ip any any -> 127.0.0.0/8 any (msg:"External to Loopback"; sid:1000021; rev:1;)

# === Protocol Violations ===
# Detect malformed HTTP requests
alert tcp any any -> $HOME_NET 80 (msg:"HTTP Malformed Request"; flow:to_server,established; content:!"HTTP/"; http_method; sid:1000022; rev:1;)